# Server-only environment variables for Makezaa
# Copy the entries you actually use into your real hosting environment.
# Do not commit real secrets.

MAKEZAA_AGENT_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAKEZAA_SITE_URL=https://www.makezaa.com
# Optional trusted additional browser origins / image hosts (comma-separated)
MAKEZAA_MCP_ALLOWED_ORIGINS=
MAKEZAA_IMAGE_HOSTS=
